# Copy to .env and fill in real values. Never commit .env.
# Only placeholders go here: no real keys, passwords or URLs.
# Each key is added in the same pull request as the code that first reads it.

# Runtime environment: development | test | production
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# PostgreSQL (docker compose exposes it on 5433)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/app
TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/app_test


# LLM gateway. Read only when a gateway is built: the data and document pipelines need none of these.
# Both providers are services that speak the OpenAI chat format. Prices are in US dollars per
# million tokens.
# Most the gateway may spend on model calls in one calendar month (UTC), in US dollars
LLM_MONTHLY_BUDGET_USD=3.00

# Primary provider: a hosted API. Placeholder only, the real key goes in .env
LLM_PRIMARY_BASE_URL=https://api.openai.com/v1
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_PRIMARY_API_KEY=replace-with-your-api-key
LLM_PRIMARY_INPUT_USD_PER_MTOK=0.15
LLM_PRIMARY_OUTPUT_USD_PER_MTOK=0.60

# Fallback provider (optional): an open-weight model on a second hosted API. Set the base URL
# and the model together, or leave both empty for no fallback. Placeholder key only.
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_API_KEY=replace-with-your-fallback-api-key
# Prices default to 0 when left empty (a provider that does not charge)
LLM_FALLBACK_INPUT_USD_PER_MTOK=0.075
LLM_FALLBACK_OUTPUT_USD_PER_MTOK=0.30


LLM_TIMEOUT_SECONDS=60
PROMPT_DIR=config/prompts

MODEL_DIR=models

RULES_AMOUNT_FLOOR_USD=25

LLM_EMBEDDING_MODEL=text-embedding-3-small
LLM_EMBEDDING_USD_PER_MTOK=0.02

AGENT_WIN_THRESHOLD=0.30

AUTH_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
AUTH_TOKEN_TTL_MINUTES=60
AUTH_COOKIE_SECURE=false

UPLOAD_MAX_BYTES=1000000
# Login limit: a login is refused when the typed email or the client IP has this many
# failed logins inside the window. Optional; the defaults are shown.
LOGIN_LIMIT_WINDOW_MINUTES=15
LOGIN_LIMIT_PER_EMAIL=5
LOGIN_LIMIT_PER_IP=20

# Password reset (architecture 3.18, "Sending email").
# The address the browser opens the app at; reset links are built from it. Required.
APP_PUBLIC_URL=http://127.0.0.1:5173
# outbox: write each email as a .eml file (local development only, needs AUTH_COOKIE_SECURE=false).
# smtp: really send (port 587 with STARTTLS; 465 is not supported);
# then MAIL_SMTP_HOST, MAIL_SMTP_USERNAME, MAIL_SMTP_PASSWORD and MAIL_FROM are required.
MAIL_BACKEND=outbox
MAIL_OUTBOX_DIR=var/outbox
MAIL_SMTP_HOST=smtp-relay.brevo.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USERNAME=replace-with-your-smtp-login
MAIL_SMTP_PASSWORD=replace-with-your-smtp-key
MAIL_FROM=replace-with-your-verified-sender@example.com
PASSWORD_RESET_PER_EMAIL_PER_HOUR=3
# Emailed 6-digit codes (sign-up confirmation and password reset).
# How long a code works, in minutes.
EMAIL_CODE_TTL_MINUTES=10
# Wrong tries before a code is deleted.
EMAIL_CODE_MAX_WRONG_TRIES=5
# Seconds a user waits between two sign-up
EMAIL_CODE_RESEND_SECONDS=60
# Sign-up codes one user can get in one hou
EMAIL_CODE_PER_USER_PER_HOUR=5
# Emails the app sends in one UTC day, overee plan allows 300).
MAIL_DAILY_LIMIT=250  


# "Continue with Google" (optional, off unless both keys are set; see README "Running it locally").
# Client ID and secret from Google Cloud (OAuth client, type Web application, redirect URI
# APP_PUBLIC_URL + /auth/google/callback). Keep both empty here; real values go in .env only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google's endpoints (from its discovery document); change only for a test double.
GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_ISSUERS=https://accounts.google.com,accounts.google.com

# Production compose (deploy/prod/.env only)
# Database password; goes inside DATABASE_URL, so URL-safe: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Public name Caddy serves (and gets a TLS certificate for); localhost for a local run
SITE_ADDRESS=localhost
# Host folder with the trained model files (default ../../models, the repo's models/)
MODEL_HOST_DIR=../../models

SHARED_ACCOUNT_NAME=Example Clinic
ADMIN_EMAILS=admin@example.test
SIGNUP_ALLOWED_EMAILS=rev1@example.test,rev2@example.test
SIGNUP_ALLOWED_DOMAINS= 