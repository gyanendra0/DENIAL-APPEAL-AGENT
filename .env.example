# Copy to .env and fill in real values. Never commit .env.
# Only placeholders go here: no real keys, passwords or URLs.
# Each key is added in the same pull request as the code that first reads it.

# Runtime environment: development | test | production
APP_ENV=development

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO


# PostgreSQL (docker compose exposes it on 5433)
DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/app
TEST_DATABASE_URL=postgresql+psycopg://app:app@localhost:5433/app_test


# LLM gateway. Read only when a gateway is built: the data and document pipelines need none of these.
# Both providers are services that speak the OpenAI chat format. Prices are in US dollars per
# million tokens.
# Most the gateway may spend on model calls in one calendar month (UTC), in US dollars
LLM_MONTHLY_BUDGET_USD=3.00

# Primary provider: a hosted API. Placeholder only, the real key goes in .env
LLM_PRIMARY_BASE_URL=https://api.openai.com/v1
LLM_PRIMARY_MODEL=gpt-4o-mini
LLM_PRIMARY_API_KEY=replace-with-your-api-key
LLM_PRIMARY_INPUT_USD_PER_MTOK=0.15
LLM_PRIMARY_OUTPUT_USD_PER_MTOK=0.60

# Fallback provider (optional): an open-weight model on a second hosted API. Set the base URL
# and the model together, or leave both empty for no fallback. Placeholder key only.
LLM_FALLBACK_BASE_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_API_KEY=replace-with-your-fallback-api-key
# Prices default to 0 when left empty (a provider that does not charge)
LLM_FALLBACK_INPUT_USD_PER_MTOK=0.075
LLM_FALLBACK_OUTPUT_USD_PER_MTOK=0.30
