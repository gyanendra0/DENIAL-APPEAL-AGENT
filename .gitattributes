# Normalise line endings so the repository stays consistent.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files: never convert
*.png      binary
*.jpg      binary
*.jpeg     binary
*.pdf      binary
*.zip      binary
*.gz       binary
*.pkl      binary
*.joblib   binary
*.parquet  binary

# Generated files: collapse in pull request diffs
package-lock.json  linguist-generated=true
uv.lock            linguist-generated=true
